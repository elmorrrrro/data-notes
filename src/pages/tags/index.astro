---
import Base from '../../layouts/Base.astro';
import { getPosts, tagSlug } from '../../lib/posts';

const counts = new Map<string, number>();
for (const p of await getPosts()) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Base title="Tags">
  <section class="wrap">
    <h1>Tags</h1>
    <div class="tags">
      {
        tags.map(([t, n]) => (
          <a class="tag" href={`/tags/${tagSlug(t)}/`}>
            {t} <span class="muted">{n}</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .tag {
    font-size: 0.95rem;
  }
</style>
