---
// Scoreboard: a verdict banner plus one card per brand with a comparable meter.
import data from '../data/intel-vs-amd-2026-10/cpus.json';

const brand = Object.fromEntries(data.by_brand.map((b) => [b.brand, b]));
const best = Object.fromEntries(data.best_value.map((b) => [b.brand, b]));
const ratio = brand.Intel.median_mark_per_dollar / brand.AMD.median_mark_per_dollar;
const top = Math.max(brand.Intel.median_mark_per_dollar, brand.AMD.median_mark_per_dollar);

const cards = [
  { key: 'Intel', css: 'intel', line: 'Core Ultra 200S / 200S Plus', prefix: 'Core Ultra' },
  { key: 'AMD', css: 'amd', line: 'Ryzen 9000', prefix: 'Ryzen' },
] as const;
---

<section class="board" aria-label="Key numbers">
  <div class="verdict">
    <div class="verdict-text">
      <span class="eyebrow">Verdict</span>
      <p class="headline">
        Intel delivers <span class="big">{ratio.toFixed(1)}×</span> AMD's multi-thread performance per dollar
      </p>
      <p class="sub">Median of {brand.Intel.models} Intel vs {brand.AMD.models} AMD current-generation desktop CPUs, US prices on Oct 3, 2026</p>
    </div>
  </div>

  <div class="brands">
    {
      cards.map((c) => {
        const b = brand[c.key];
        const v = best[c.key];
        return (
          <div class={`brand ${c.css}`}>
            <div class="brand-head">
              <span class="badge" aria-hidden="true">{c.key[0]}</span>
              <div>
                <p class="name">{c.key}</p>
                <p class="line">
                  {c.line} · {b.models} chips
                </p>
              </div>
            </div>
            <p class="value">
              {b.median_mark_per_dollar.toFixed(0)}
              <span class="unit">pts per $ (median)</span>
            </p>
            <div class="meter" role="img" aria-label={`${b.median_mark_per_dollar.toFixed(0)} of ${top.toFixed(0)}`}>
              <span style={`width: ${(b.median_mark_per_dollar / top) * 100}%`} />
            </div>
            <dl>
              <div>
                <dt>Best value</dt>
                <dd>
                  {c.prefix} {v.short}
                </dd>
              </div>
              <div>
                <dt>Its score</dt>
                <dd>
                  {v.mark_per_dollar.toFixed(0)} pts/$ · ${v.price_usd}
                </dd>
              </div>
            </dl>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .board {
    display: grid;
    gap: 14px;
    margin: 2.2em 0;
  }

  /* Verdict banner with a two-brand gradient border. */
  .verdict {
    position: relative;
    padding: 26px 28px;
    border-radius: var(--radius);
    border: 1.5px solid transparent;
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      linear-gradient(110deg, var(--intel), var(--amd)) border-box;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .verdict::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(400px 200px at 0% 0%, color-mix(in srgb, var(--intel) 10%, transparent), transparent 70%),
      radial-gradient(400px 200px at 100% 100%, color-mix(in srgb, var(--amd) 10%, transparent), transparent 70%);
  }
  .verdict-text {
    position: relative;
    z-index: 1;
  }
  .eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .headline {
    margin: 6px 0 8px;
    font-family: var(--display);
    font-size: clamp(1.35rem, 3.4vw, 1.9rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .big {
    font-size: 1.6em;
    font-weight: 700;
    background: linear-gradient(100deg, var(--intel), var(--amd));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* Brand cards */
  .brands {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 620px) {
    .brands {
      grid-template-columns: 1fr 1fr;
    }
  }
  .brand {
    --c: var(--intel);
    position: relative;
    padding: 22px 22px 18px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: linear-gradient(180deg, color-mix(in srgb, var(--c) 7%, var(--surface)), var(--surface) 60%);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .brand.amd {
    --c: var(--amd);
  }
  .brand::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--c);
  }
  .brand-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .badge {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: var(--c);
    color: #fff;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.15rem;
    box-shadow: 0 6px 16px -6px var(--c);
  }
  .name {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1.2;
  }
  .line {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .value {
    margin: 18px 0 10px;
    font-family: var(--display);
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .unit {
    display: block;
    margin-top: 6px;
    font-family: var(--font);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }
  .meter {
    height: 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--c) 16%, transparent);
    overflow: hidden;
  }
  .meter span {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--c);
  }
  dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 18px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  dt {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  dd {
    margin: 2px 0 0;
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
