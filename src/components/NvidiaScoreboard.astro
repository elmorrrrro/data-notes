---
// Scoreboard for the Nvidia "how big a beat" study: the duel banner plus one card per finding.
import s from '../data/nvidia-beat-math-2026-11/summary.json';
import reports from '../data/nvidia-beat-math-2026-11/reports.json';

const pct = (n: number) => `${n > 0 ? '+' : n < 0 ? '−' : ''}${Math.abs(n).toFixed(1)}%`;
const big = reports.filter((r) => r.revenue_beat_pct >= s.cut);
const g = s.max_guide_beat;

const cards = [
  {
    css: 'neutral',
    name: 'The streak',
    value: `${s.falls} of ${s.n}`,
    unit: `reports after which the stock fell, although every one beat the forecasts`,
    rows: [
      { k: 'Average revenue beat', v: `${s.avg_rev_beat}%` },
      { k: 'Rose / fell', v: `${s.rises} / ${s.falls}` },
    ],
  },
  {
    css: 'stocks',
    name: `Revenue beat of ${s.cut}% or more`,
    value: `${s.big.rises} of ${s.big.n}`,
    unit: 'times the stock went up the next day',
    rows: [
      { k: `Beat under ${s.cut}%`, v: `${s.small.rises} of ${s.small.n} rose` },
      { k: 'Biggest beat', v: `${Math.max(...big.map((r) => r.revenue_beat_pct)).toFixed(1)}%` },
    ],
  },
  {
    css: 'bonds',
    name: 'Next-quarter forecast',
    value: 'No pattern',
    unit: 'a bigger beat on the outlook did not mean a better day',
    rows: [
      { k: `Biggest (${g.label})`, v: `+${g.guidance_beat_pct.toFixed(1)}%` },
      { k: 'Stock next day', v: pct(g.move_pct) },
    ],
  },
  {
    css: 'neutral',
    name: 'Never seen before',
    value: pct(s.next.run_in_pct),
    unit: `the stock's last ${20} trading days before this report`,
    rows: [
      { k: 'Weakest run-in of the 10', v: pct(s.min_run_in) },
      { k: 'All 10 before', v: 'went up' },
    ],
  },
];
---

<section class="board" aria-label="Key numbers">
  <div class="verdict">
    <span class="eyebrow">Nvidia's revenue for the quarter it reports on November 17</span>
    <div class="duel">
      <div class="side bonds">
        <span class="who">Wall Street expects</span>
        <span class="num">${s.next.street}B</span>
        <span class="note">average of {s.next.analysts} analysts (Yahoo Finance)</span>
      </div>
      <span class="vs" aria-hidden="true">vs</span>
      <div class="side stocks">
        <span class="who">The "go up" line</span>
        <span class="num">${s.next.need}B</span>
        <span class="note">a {s.cut}% beat, the size that came with 3 of 4 rises</span>
      </div>
    </div>
    <p class="sub">Ten reports is a tiny sample. Read the line as a rule of thumb, not a law.</p>
  </div>

  <div class="groups">
    {
      cards.map((c) => (
        <div class={`group ${c.css}`}>
          <p class="name">{c.name}</p>
          <p class="value">
            {c.value}
            <span class="unit">{c.unit}</span>
          </p>
          <dl>
            {c.rows.map((row) => (
              <div>
                <dt>{row.k}</dt>
                <dd>{row.v}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))
    }
  </div>
</section>

<style>
  .board {
    display: grid;
    gap: 14px;
    margin: 2.2em 0;
  }
  .verdict {
    padding: 24px 26px;
    border-radius: var(--radius);
    border: 1.5px solid transparent;
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      linear-gradient(110deg, var(--accent-1), var(--accent-2)) border-box;
    box-shadow: var(--shadow);
  }
  .eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .duel {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    margin: 14px 0 12px;
  }
  .side {
    display: grid;
    gap: 2px;
  }
  .side.stocks {
    text-align: right;
  }
  .who {
    font-weight: 650;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .num {
    font-family: var(--display);
    font-size: clamp(2.2rem, 7vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .stocks .num {
    color: var(--up);
  }
  .bonds .num {
    color: var(--down);
  }
  .note {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .vs {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 10px;
  }
  .sub {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-2);
  }
  .groups {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 620px) {
    .groups {
      grid-template-columns: 1fr 1fr;
    }
  }
  .group {
    --c: var(--axis);
    position: relative;
    padding: 20px 22px 16px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .group.stocks {
    --c: var(--up);
  }
  .group.bonds {
    --c: var(--down);
  }
  .group::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--c);
  }
  .name {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .value {
    margin: 12px 0 4px;
    font-family: var(--display);
    font-size: 2.6rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .unit {
    display: block;
    margin-top: 6px;
    font-family: var(--font);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }
  dl {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  dt {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  dd {
    margin: 2px 0 0;
    font-size: 1rem;
    font-weight: 650;
  }
</style>
