---
// The four listed companies tied to small attack drones: what they sell, how big they are, how the share moved.
import companies from '../data/fpv-drone-cost-2026-10/companies.json';
import stats from '../data/fpv-drone-cost-2026-10/stats.json';

const money = (n: number) => (n >= 1e9 ? `$${(n / 1e9).toFixed(1)}B` : `$${(n / 1e6).toFixed(1)}M`);
const pct = (n: number) => `${n >= 0 ? '+' : '−'}${Math.round(Math.abs(n) * 100)}%`;
const fy = (end: string) => (end.endsWith('12-31') ? end.slice(0, 4) : `FY to ${new Date(end).toLocaleString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })}`);
const rows = [...companies].sort((a, b) => b.change - a.change);
---

<div class="table-wrap card">
  <table>
    <thead>
      <tr>
        <th>Company</th>
        <th>Tie to small drones</th>
        <th class="r">Revenue, last year</th>
        <th class="r">Share since Spiderweb</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((d) => (
          <tr>
            <td>
              <span class="swatch" style={`background: var(--${d.ticker.toLowerCase()})`} />
              <strong>{d.name}</strong> <span class="muted">{d.ticker}</span>
            </td>
            <td class="wrap">{d.role}</td>
            <td class="r num">
              {money(d.revenue_usd)} <span class="muted">{fy(d.fy_end)}</span>
            </td>
            <td class="r num strong">{pct(d.change)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<p class="muted note">
  Share prices: close on May 30, 2025 (the last before Spiderweb) vs October 7, 2026; the S&P 500 (SPY) did {pct(stats.spy_change)}.
  Revenue: the latest annual report on SEC EDGAR.
</p>

<style>
  .table-wrap {
    margin: 1.5em 0 0.6em;
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
    white-space: nowrap;
  }
  th,
  td {
    padding: 9px 12px;
    text-align: left;
    border-bottom: 1px solid var(--grid);
  }
  th {
    font-weight: 600;
    font-size: 0.76rem;
    color: var(--muted);
  }
  .wrap {
    white-space: normal;
    min-width: 200px;
  }
  tbody tr:last-child td {
    border-bottom: 0;
  }
  .r {
    text-align: right;
  }
  .swatch {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    margin-right: 7px;
  }
  .strong {
    font-weight: 650;
  }
  .note {
    font-size: 0.8rem;
    margin: 0 4px 1.5em;
  }
</style>
