---
// Scoreboard for the EV vs petrol study: a verdict banner plus one card per link in the chain.
import costs from '../data/ev-vs-petrol-2026-10/costs.json';
import stocks from '../data/ev-vs-petrol-2026-10/stocks.json';

const s = costs.summary;
const r = s.registrations;
const toyota = stocks.stocks.find((x) => x.name === 'Toyota')!;
const byd = stocks.stocks.find((x) => x.name === 'BYD')!;
const eur = (n: number) => `€${n.toFixed(2)}`;
const pct = (n: number) => `${n > 0 ? '+' : n < 0 ? '−' : ''}${Math.abs(n).toFixed(0)}%`;

const cards = [
  {
    css: 'pump',
    name: 'At the pump',
    value: pct(s.petrol_l.change_pct),
    unit: 'petrol since the war began',
    rows: [
      { k: 'Diesel', v: pct(s.diesel_l.change_pct) },
      { k: 'Petrol, 100 km', v: eur(s.per100.petrol.now) },
    ],
  },
  {
    css: 'plug',
    name: 'At the plug',
    value: pct(s.kwh.change_pct),
    unit: 'household electricity',
    rows: [
      { k: 'EV, 100 km', v: eur(s.per100.ev.now) },
      { k: 'Saved a year', v: `€${s.saving_year.ev_home_vs_petrol.toLocaleString('en-US')}` },
    ],
  },
  {
    css: 'shop',
    name: 'In showrooms',
    value: `${r.aug_2026_bev.toFixed(0)}%`,
    unit: 'of new EU cars were electric in August',
    rows: [
      { k: 'A year earlier', v: `${r.aug_2025_bev.toFixed(0)}%` },
      { k: 'Petrol + diesel', v: `${r.aug_2026_fossil.toFixed(0)}%` },
    ],
  },
  {
    css: 'market',
    name: 'On the stock market',
    value: pct(toyota.change_pct),
    unit: 'Toyota shares since the war began',
    rows: [
      { k: 'BYD', v: pct(byd.change_pct) },
      { k: 'Nikkei 225', v: pct(toyota.market_pct) },
    ],
  },
];
---

<section class="board" aria-label="Key numbers">
  <div class="verdict">
    <span class="eyebrow">The war's bill, per 100 km</span>
    <p class="headline">
      Petrol now costs <span class="big">{eur(s.per100.petrol.now)}</span>. Charging an EV at home costs <span class="big"
        >{eur(s.per100.ev.now)}</span
      >, the same as before the war.
    </p>
    <p class="sub">EU averages, week of October 5, 2026, for a typical small family car</p>
  </div>

  <div class="groups">
    {
      cards.map((c) => (
        <div class={`group ${c.css}`}>
          <p class="name">{c.name}</p>
          <p class="value">
            {c.value}
            <span class="unit">{c.unit}</span>
          </p>
          <dl>
            {c.rows.map((row) => (
              <div>
                <dt>{row.k}</dt>
                <dd>{row.v}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))
    }
  </div>
</section>

<style>
  .board {
    display: grid;
    gap: 14px;
    margin: 2.2em 0;
  }
  .verdict {
    padding: 26px 28px;
    border-radius: var(--radius);
    border: 1.5px solid transparent;
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      linear-gradient(110deg, var(--accent-1), var(--accent-2)) border-box;
    box-shadow: var(--shadow);
  }
  .eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .headline {
    margin: 6px 0 8px;
    font-family: var(--display);
    font-size: clamp(1.3rem, 3.2vw, 1.8rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .big {
    font-weight: 700;
    background: linear-gradient(100deg, var(--accent-1), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .groups {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 620px) {
    .groups {
      grid-template-columns: 1fr 1fr;
    }
  }
  .group {
    --c: var(--ev-petrol);
    position: relative;
    padding: 20px 22px 16px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .group.plug {
    --c: var(--ev-electric);
  }
  .group.shop {
    --c: var(--ev-electric);
  }
  .group.market {
    --c: var(--toyota);
  }
  .group::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--c);
  }
  .name {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .value {
    margin: 12px 0 4px;
    font-family: var(--display);
    font-size: 2.6rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .unit {
    display: block;
    margin-top: 6px;
    font-family: var(--font);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }
  dl {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  dt {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  dd {
    margin: 2px 0 0;
    font-size: 1rem;
    font-weight: 650;
  }
</style>
