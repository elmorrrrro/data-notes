---
// Scoreboard for the Oracle $30B-vs-$6B study: the duel banner plus one card per part of the math.
import s from '../data/oracle-30b-bet-2026-11/summary.json';

const b = (n: number) => `$${n.toFixed(1)}B`;
const [lo, hi] = s.cases;

const cards = [
  {
    css: 'neutral',
    name: 'Where it is now',
    value: `−${b(-s.fy26.fcf)}`,
    unit: 'free cash flow in fiscal 2026 (to May 2026)',
    rows: [
      { k: 'Spent on data centers', v: b(s.fy26.capex) },
      { k: 'First quarter of fiscal 2027', v: `−${b(-s.q1.fcf)}` },
    ],
  },
  {
    css: 'stocks',
    name: 'What $30B needs',
    value: `$${Math.round(lo.capex_for_target)}–${Math.round(hi.capex_for_target)}B`,
    unit: 'the most Oracle could spend on building in fiscal 2029',
    rows: [
      { k: 'Planned this year', v: `$${s.fy27.capex_lo}–${s.fy27.capex_hi}B` },
      { k: 'Cut needed', v: `${Math.round(s.capex_cut_lo * 100)}–${Math.round(s.capex_cut_hi * 100)}%` },
    ],
  },
  {
    css: 'neutral',
    name: 'While sales keep growing',
    value: `$${Math.round(s.rev29)}B`,
    unit: "fiscal 2029 revenue on the way to Oracle's $225B goal for fiscal 2030",
    rows: [
      { k: 'This year', v: `$${s.fy27.revenue}B+` },
      { k: 'Growth a year', v: `${Math.round(s.growth * 100)}%` },
    ],
  },
  {
    css: 'bonds',
    name: 'The catch',
    value: b(s.q1.prepay),
    unit: 'paid in advance by customers last quarter, counted as cash Oracle made',
    rows: [
      { k: 'Reported free cash flow', v: `−${b(-s.q1.fcf)}` },
      { k: 'Without the prepayments', v: `−${b(-(s.q1.fcf - s.q1.prepay))}` },
    ],
  },
];
---

<section class="board" aria-label="Key numbers">
  <div class="verdict">
    <span class="eyebrow">Oracle's free cash flow in fiscal 2029 (June 2028 to May 2029)</span>
    <div class="duel">
      <div class="side stocks">
        <span class="who">Oracle says</span>
        <span class="num">$30B+</span>
        <span class="note">target set at Investor Day, Oct 28</span>
      </div>
      <span class="vs" aria-hidden="true">vs</span>
      <div class="side bonds">
        <span class="who">Analysts expected</span>
        <span class="num">${s.consensus}B</span>
        <span class="note">consensus before that day (TIKR)</span>
      </div>
    </div>
    <p class="sub">The ${s.gap} billion gap is less than what Oracle spends on data centers in one quarter today.</p>
  </div>

  <div class="groups">
    {
      cards.map((c) => (
        <div class={`group ${c.css}`}>
          <p class="name">{c.name}</p>
          <p class="value">
            {c.value}
            <span class="unit">{c.unit}</span>
          </p>
          <dl>
            {c.rows.map((row) => (
              <div>
                <dt>{row.k}</dt>
                <dd>{row.v}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))
    }
  </div>
</section>

<style>
  .board {
    display: grid;
    gap: 14px;
    margin: 2.2em 0;
  }
  .verdict {
    padding: 24px 26px;
    border-radius: var(--radius);
    border: 1.5px solid transparent;
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      linear-gradient(110deg, var(--accent-1), var(--accent-2)) border-box;
    box-shadow: var(--shadow);
  }
  .eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .duel {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    margin: 14px 0 12px;
  }
  .side {
    display: grid;
    gap: 2px;
  }
  .side.bonds {
    text-align: right;
  }
  .who {
    font-weight: 650;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .num {
    font-family: var(--display);
    font-size: clamp(2.2rem, 7vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .stocks .num {
    color: var(--or-stocks);
  }
  .bonds .num {
    color: var(--or-bonds);
  }
  .note {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .vs {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 10px;
  }
  .sub {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-2);
  }
  .groups {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 620px) {
    .groups {
      grid-template-columns: 1fr 1fr;
    }
  }
  .group {
    --c: var(--axis);
    position: relative;
    padding: 20px 22px 16px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .group.stocks {
    --c: var(--or-stocks);
  }
  .group.bonds {
    --c: var(--or-bonds);
  }
  .group::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--c);
  }
  .name {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .value {
    margin: 12px 0 4px;
    font-family: var(--display);
    font-size: 2.6rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .unit {
    display: block;
    margin-top: 6px;
    font-family: var(--font);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }
  dl {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  dt {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  dd {
    margin: 2px 0 0;
    font-size: 1rem;
    font-weight: 650;
  }
</style>
