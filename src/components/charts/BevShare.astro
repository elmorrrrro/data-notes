---
import Figure from './Figure.astro';
---

<Figure
  id="bev-share"
  title="Battery-electric share of new cars in the EU, 2026 vs 2025"
  subtitle="Percent of new-car registrations each month. The war with Iran began on February 28, 2026."
  source="Source: ACEA monthly new-car registration releases. July 2026 is derived from ACEA's year-to-date figures."
  legendItems={[
    { label: '2026', color: 'var(--ev-electric)' },
    { label: '2025', color: 'var(--muted)' },
  ]}
  height={300}
/>

<script>
  import * as Plot from '@observablehq/plot';
  import data from '../../data/ev-vs-petrol-2026-10/registrations.json';
  import { mount, base, tipStyle } from '../../lib/chart';

  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const rows = data.map((r) => ({ ...r, year: r.month.slice(0, 4), m: MONTHS[Number(r.month.slice(5)) - 1] }));
  const byKey = new Map(rows.map((r) => [`${r.year}-${r.m}`, r]));
  const y26 = rows.filter((r) => r.year === '2026');
  const tipRows = y26.map((r) => ({ ...r, prev: byKey.get(`2025-${r.m}`)! }));
  const last = y26[y26.length - 1];
  const pct = (n: number) => `${n.toFixed(1)}%`;

  mount(document.querySelector<HTMLElement>('#bev-share .plot')!, (width, t) => {
    const ev = getComputedStyle(document.documentElement).getPropertyValue('--ev-electric').trim();
    const color = (y: string) => (y === '2026' ? ev : t.muted);
    return Plot.plot({
      ...base(t, width),
      height: 300,
      marginRight: 20,
      x: { type: 'point', domain: MONTHS, label: null, tickFormat: (m: string, i: number) => (width < 520 && i % 2 ? '' : m) },
      y: { label: '↑ % of new cars', domain: [0, 30], grid: false },
      marks: [
        Plot.gridY({ stroke: t.grid, strokeOpacity: 1 }),
        Plot.ruleX(['Feb'], { stroke: t.axis, strokeDasharray: '3,3' }),
        Plot.text(['War'], { x: () => 'Feb', frameAnchor: 'top', dx: 6, dy: 4, textAnchor: 'start', fill: t.muted, fontSize: 11 }),
        Plot.line(rows, { x: 'm', y: 'bev_share', z: 'year', stroke: (d) => color(d.year), strokeWidth: (d) => (d.year === '2026' ? 2.5 : 1.5) }),
        Plot.dot(rows, { x: 'm', y: 'bev_share', fill: (d) => color(d.year), r: 2.5 }),
        Plot.text([last], { x: 'm', y: 'bev_share', text: (d) => pct(d.bev_share), dx: 8, textAnchor: 'start', fill: ev, fontWeight: 700, fontSize: 12 }),
        Plot.tip(
          tipRows,
          Plot.pointerX({
            x: 'm',
            y: 'bev_share',
            ...tipStyle(t),
            title: (d) =>
              `${d.m} 2026: ${pct(d.bev_share)} electric (2025: ${pct(d.prev.bev_share)})\n` +
              `Hybrid ${pct(d.hev_share)} · Plug-in hybrid ${pct(d.phev_share)}\n` +
              `Petrol and diesel ${pct(d.fossil_share)} (2025: ${pct(d.prev.fossil_share)})\n` +
              `${d.total.toLocaleString('en-US')} new cars`,
          }),
        ),
      ],
    });
  });
</script>
