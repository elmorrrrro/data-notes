---
import Figure from './Figure.astro';
---

<Figure
  id="prepay-gap"
  title="Free cash flow with and without customers' prepayments"
  subtitle="$ billions. Oracle counts money customers pay in advance for future data-center capacity as cash from operations."
  source="Source: Oracle results releases for fiscal 2026 (Jun 10, 2026) and Q1 fiscal 2027 (Sep 10, 2026), SEC 8-K; 'without' is our arithmetic."
  legendItems={[
    { label: 'As Oracle reports it', color: 'var(--or-stocks)' },
    { label: 'Without prepayments', color: 'var(--or-bonds)' },
  ]}
  height={220}
/>

<script>
  import * as Plot from '@observablehq/plot';
  import prepay from '../../data/oracle-30b-bet-2026-11/prepay.json';
  import { mount, base, tipStyle } from '../../lib/chart';

  type Row = { label: string; period: string; value: number; kind: 'reported' | 'without'; prepay: number };
  const rows: Row[] = prepay.flatMap((p) => [
    { label: `${p.period}: reported`, period: p.period, value: p.reported, kind: 'reported' as const, prepay: p.prepay },
    { label: `${p.period}: without`, period: p.period, value: p.without, kind: 'without' as const, prepay: p.prepay },
  ]);
  const fmt = (n: number) => `−$${Math.abs(n).toFixed(1)}B`;

  mount(document.querySelector<HTMLElement>('#prepay-gap .plot')!, (width, t) => {
    const css = getComputedStyle(document.documentElement);
    const color = { reported: css.getPropertyValue('--or-stocks').trim(), without: css.getPropertyValue('--or-bonds').trim() };
    const narrow = width < 520;
    return Plot.plot({
      ...base(t, width),
      height: 220,
      marginLeft: narrow ? 118 : 190,
      marginRight: 20,
      marginBottom: 30,
      x: { domain: [-36, 0], label: null, ticks: narrow ? [-30, -15, 0] : 4, tickFormat: (x: number) => (x === 0 ? '0' : `−$${Math.abs(x)}B`) },
      y: { domain: rows.map((r) => r.label), label: null, padding: 0.3, tickSize: 0, tickFormat: (d: string) => d.replace(': reported', '').replace(/^.*: without$/, '') },
      marks: [
        Plot.gridX({ stroke: t.grid, strokeOpacity: 1, ticks: narrow ? [-30, -15, 0] : 4 }),
        Plot.barX(rows, { x1: 0, x2: 'value', y: 'label', fill: (r: Row) => color[r.kind], rx: 4 }),
        Plot.text(rows, { x: 'value', y: 'label', text: (r: Row) => fmt(r.value), textAnchor: 'end', dx: -6, fill: t.ink2, fontWeight: 650, fontSize: 12 }),
        Plot.tip(rows, Plot.pointerY({
          x: 'value', y: 'label', ...tipStyle(t),
          title: (r: Row) => r.kind === 'reported'
            ? `${r.period}, as reported: ${fmt(r.value)}\nIncludes $${r.prepay}B paid in advance by customers`
            : `${r.period}, without the $${r.prepay}B of prepayments: ${fmt(r.value)}`,
        })),
      ],
    });
  });
</script>
