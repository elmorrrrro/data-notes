---
// Hero for the Hormuz study: a schematic strait where each day's ship count becomes moving dots,
// with play/scrub controls and a daily strip chart (click to jump, hover for numbers).
import Figure from './Figure.astro';
---

<Figure
  id="ship-flow"
  title="Hormuz as open satellite data sees it"
  subtitle="Every dot is a ship seen on satellite tracking (AIS), at the pace of that day's count. Schematic map, not to scale."
  legendItems={[
    { label: 'Tanker', color: 'var(--hz-oil)' },
    { label: 'Other ship', color: 'var(--hz-seen)' },
  ]}
  source="Source: IMF PortWatch, daily chokepoint transits from AIS data. Events: Wikipedia, 2025–2026 Iran–United States negotiations."
  height={0}
>
  <div class="stage">
    <canvas aria-label="Animated schematic of ships crossing the Strait of Hormuz, day by day since January 2025" role="img"></canvas>
    <div class="ticker" aria-live="polite">
      <span class="date"></span>
      <span class="count"><b></b> ships seen that day</span>
    </div>
    <div class="toast" aria-hidden="true"></div>
  </div>
  <div class="controls">
    <button type="button" class="play" aria-label="Play">▶</button>
    <input type="range" min="0" max="1" step="1" value="0" aria-label="Day" />
  </div>
  <div class="strip"></div>
</Figure>

<style>
  .stage {
    position: relative;
    margin-top: 12px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  canvas {
    display: block;
    width: 100%;
  }
  .ticker {
    position: absolute;
    left: 14px;
    top: 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    pointer-events: none;
  }
  .date {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .count {
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .count b {
    font-family: var(--display);
    font-size: 1.9rem;
    line-height: 1;
    color: var(--ink);
    margin-right: 4px;
    font-variant-numeric: tabular-nums;
  }
  .toast {
    position: absolute;
    left: 50%;
    bottom: 12px;
    transform: translateX(-50%);
    max-width: calc(100% - 28px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--axis);
    background: var(--surface);
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 600;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .toast.on {
    opacity: 1;
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }
  .play {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--axis);
    background: var(--surface);
    color: var(--ink);
    font-size: 0.9rem;
    cursor: pointer;
  }
  .play:hover {
    border-color: var(--ink-2);
  }
  input[type='range'] {
    flex: 1;
    accent-color: var(--hz-oil);
  }
  .strip {
    margin-top: 6px;
    cursor: pointer;
  }
  .strip :global(svg) {
    display: block;
  }
</style>

<script>
  import * as Plot from '@observablehq/plot';
  import data from '../../data/hormuz-shipping-2026-10/hormuz.json';
  import { mount, base, tipStyle } from '../../lib/chart';

  type Day = (typeof data.daily)[number];
  type Ship = { born: number; dir: 1 | -1; tanker: boolean; lane: number; speed: number; gone?: number };

  const root = document.querySelector<HTMLElement>('#ship-flow')!;
  const canvas = root.querySelector('canvas')!;
  const ctx = canvas.getContext('2d')!;
  const dateEl = root.querySelector<HTMLElement>('.date')!;
  const countEl = root.querySelector<HTMLElement>('.count b')!;
  const toast = root.querySelector<HTMLElement>('.toast')!;
  const btn = root.querySelector<HTMLButtonElement>('.play')!;
  const slider = root.querySelector<HTMLInputElement>('input[type=range]')!;
  const stripEl = root.querySelector<HTMLElement>('.strip')!;

  const days: Day[] = data.daily;
  // The strait's fill follows a 3-day average, so daily noise doesn't make ships blink in and out.
  const smooth = days.map((_d, i) => days.slice(Math.max(0, i - 2), i + 1).reduce((a, d) => a + d.n, 0) / Math.min(3, i + 1));
  const utc = (d: string) => new Date(`${d}T12:00:00Z`);
  const fmt = (d: string) => utc(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
  const events = data.events.map((e) => ({ ...e, i: days.findIndex((d) => d.date === e.date) }));
  const START = days.findIndex((d) => d.date === '2026-01-15');
  slider.max = String(days.length - 1);

  // World is 1000 x 420: the Persian Gulf on the left, the Gulf of Oman on the right, the strait in between.
  const WW = 1000;
  const WH = 420;
  const NARROW = 540;
  const mid = (x: number) => 175 + 95 / (1 + Math.exp(-(x - NARROW) / 110));
  const half = (x: number) => 36 + 120 * (1 - Math.exp(-(((x - NARROW) / 230) ** 2)));
  const wobble = (x: number, k: number) => 6 * Math.sin(x / 37 + k) + 4 * Math.sin(x / 13 + 2 * k);
  const north = (x: number) => mid(x) - half(x) + wobble(x, 1);
  const south = (x: number) => mid(x) + half(x) + wobble(x, 4);

  // Ships per day -> dots on screen: the strait holds day.n * K ships. A crossing takes CROSS seconds; when the
  // count drops, ships already in the strait fade out ("go dark") so the picture follows the data within a day.
  const CROSS = 7;
  const K = 0.8;
  const FADE = 0.6;
  const DAYS_PER_SEC = 8;
  let ships: Ship[] = [];
  let pos = START; // fractional day index
  let playing = false;
  let clock = 0; // seconds of animation
  let spawnDebt = 0;
  let lastEvent = -1;
  let toastTimer = 0;
  let seed = 7;
  const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);

  const css = (n: string) => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
  let W = 0;
  let H = 0;
  let scale = 1;
  let ox = 0;

  function resize() {
    W = canvas.clientWidth;
    H = Math.max(240, Math.min(W * 0.44, 380));
    scale = H / WH;
    ox = NARROW - W / scale / 2; // keep the narrows centered when the screen is narrow
    const dpr = window.devicePixelRatio || 1;
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    canvas.style.height = `${H}px`;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function spawn(i: number, dt: number) {
    const day = days[i];
    const target = smooth[i] * K;
    const alive = ships.filter((s) => s.gone === undefined);
    // Too many: the extra ships fade out, picked at random.
    for (let extra = Math.floor(alive.length - target - 0.5); extra > 0; extra--) {
      const s = alive.splice(Math.floor(rand() * alive.length), 1)[0];
      s.gone = clock;
    }
    // Steady flow replaces ships that leave; a shortfall is filled faster from both ends.
    spawnDebt += dt * (target / CROSS + Math.max(0, target - alive.length) / 1.5);
    while (spawnDebt >= 1) {
      spawnDebt -= 1;
      ships.push(newShip(day, clock));
    }
  }

  function newShip(day: Day, born: number): Ship {
    return {
      born,
      dir: rand() < 0.5 ? 1 : -1,
      tanker: rand() < day.tankers / Math.max(1, day.n),
      lane: (rand() - 0.5) * 0.5,
      speed: 0.85 + rand() * 0.3,
    };
  }

  function shipPos(s: Ship) {
    const p = ((clock - s.born) * s.speed) / CROSS; // 0..1
    const x = s.dir === 1 ? -40 + p * (WW + 80) : WW + 40 - p * (WW + 80);
    // Outbound ships (left to right) keep to the southern lane, inbound to the northern one.
    const off = (s.dir === 1 ? 0.28 : -0.28) + s.lane * 0.5;
    return { p, x, y: mid(x) + off * half(x) * 0.8 };
  }

  function draw() {
    const land = css('--grid');
    const coast = css('--axis');
    const water = css('--surface');
    const muted = css('--muted');
    const tanker = css('--hz-oil');
    const other = css('--hz-seen');
    ctx.fillStyle = water;
    ctx.fillRect(0, 0, W, H);
    ctx.lineJoin = 'round';
    ctx.save();
    ctx.scale(scale, scale);
    ctx.translate(-ox, 0);
    const x0 = ox - 10;
    const x1 = ox + W / scale + 10;
    const coastPath = (f: (x: number) => number, edge: number) => {
      ctx.beginPath();
      ctx.moveTo(x0, edge);
      for (let x = x0; x <= x1; x += 6) ctx.lineTo(x, f(x));
      ctx.lineTo(x1, edge);
      ctx.closePath();
    };
    for (const [f, edge] of [
      [north, -10],
      [south, WH + 10],
    ] as const) {
      coastPath(f, edge);
      ctx.fillStyle = land;
      ctx.fill();
      ctx.strokeStyle = coast;
      ctx.lineWidth = 1.5 / scale;
      ctx.stroke();
    }

    ctx.font = `600 ${12 / scale}px Inter, system-ui, sans-serif`;
    ctx.fillStyle = muted;
    ctx.textAlign = 'center';
    ctx.letterSpacing = '2px';
    ctx.fillText('IRAN', NARROW + 140, north(NARROW + 140) - 28 / scale);
    ctx.fillText('OMAN', NARROW - 10, south(NARROW - 10) + 40 / scale);
    ctx.letterSpacing = '0px';
    ctx.font = `500 ${11.5 / scale}px Inter, system-ui, sans-serif`;
    ctx.textAlign = 'left';
    ctx.fillText('← Persian Gulf', ox + 14 / scale, mid(ox) + half(ox) * 0.62);
    ctx.textAlign = 'right';
    ctx.fillText('Gulf of Oman →', ox + W / scale - 14 / scale, mid(ox + W / scale) - half(ox + W / scale) * 0.62);

    for (const s of ships) {
      const { x, y } = shipPos(s);
      const ahead = shipPos({ ...s, born: s.born - 0.05 });
      const a = Math.atan2(ahead.y - y, ahead.x - x);
      const len = (s.tanker ? 22 : 15) / Math.sqrt(scale);
      const wid = (s.tanker ? 8 : 6.5) / Math.sqrt(scale);
      ctx.save();
      ctx.globalAlpha = s.gone === undefined ? 1 : Math.max(0, 1 - (clock - s.gone) / FADE);
      ctx.translate(x, y);
      ctx.rotate(a);
      ctx.beginPath();
      ctx.roundRect(-len / 2, -wid / 2, len, wid, wid / 2);
      ctx.fillStyle = s.tanker ? tanker : other;
      ctx.fill();
      ctx.lineWidth = 1.5 / scale;
      ctx.strokeStyle = water;
      ctx.stroke();
      ctx.restore();
    }
    ctx.restore();
  }

  function showDay(i: number) {
    const d = days[i];
    dateEl.textContent = fmt(d.date);
    countEl.textContent = String(d.n);
    slider.value = String(i);
    cursor?.(i);
  }

  function flash(e: (typeof events)[number]) {
    toast.textContent = `${fmt(e.date).replace(/, \d{4}$/, '')} · ${e.label}`;
    toast.classList.add('on');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove('on'), 2000);
  }

  let last = 0;
  function frame(t: number) {
    const dt = Math.min(0.05, (t - (last || t)) / 1000);
    last = t;
    if (playing) {
      clock += dt;
      pos = Math.min(days.length - 1, pos + dt * DAYS_PER_SEC);
      const i = Math.floor(pos);
      spawn(i, dt);
      const ev = events.find((e) => e.i === i);
      if (ev && ev.i !== lastEvent) {
        lastEvent = ev.i;
        flash(ev);
      }
      if (+slider.value !== i) showDay(i);
      if (pos >= days.length - 1) pause();
    }
    ships = ships.filter((s) => shipPos(s).p < 1 && (s.gone === undefined || clock - s.gone < FADE));
    draw();
    requestAnimationFrame(frame);
  }

  // Fill the strait at the state of day i, as if the animation had been running.
  function prime(i: number) {
    ships = [];
    spawnDebt = 0;
    for (let k = 0; k < Math.round(smooth[i] * K); k++) ships.push(newShip(days[i], clock - rand() * CROSS * 0.9));
    pos = i;
    lastEvent = -1;
    showDay(i);
  }

  function play() {
    if (pos >= days.length - 1) prime(START);
    playing = true;
    btn.textContent = '❚❚';
    btn.setAttribute('aria-label', 'Pause');
  }
  function pause() {
    playing = false;
    btn.textContent = '▶';
    btn.setAttribute('aria-label', 'Play');
  }
  btn.addEventListener('click', () => (playing ? pause() : play()));
  slider.addEventListener('input', () => {
    pause();
    prime(+slider.value);
  });

  // Daily strip: bars for each day, a 7-day line, event rules and a cursor for the current day.
  let cursor: ((i: number) => void) | undefined;
  const rows = days.map((d, i) => ({ ...d, i, x: utc(d.date) }));
  const evRows = events.map((e) => ({ ...e, x: utc(e.date) }));
  const eventOn: Record<string, string> = Object.fromEntries(events.map((e) => [e.date, e.label]));
  mount(stripEl, (width, t) => {
    const s2 = css('--hz-oil');
    const plot = Plot.plot({
      ...base(t, width),
      height: 120,
      marginTop: 18,
      marginLeft: 34,
      marginRight: 8,
      x: { type: 'utc', label: null, ticks: width < 500 ? 4 : 8 },
      y: { label: 'ships/day', domain: [0, 130], ticks: 3, grid: false },
      marks: [
        Plot.gridY({ stroke: t.grid, strokeOpacity: 1, ticks: 3 }),
        Plot.ruleX(evRows, { x: 'x', stroke: t.axis, strokeDasharray: '2,3' }),
        Plot.rectY(rows, { x1: (d) => new Date(+d.x - 432e5), x2: (d) => new Date(+d.x + 432e5), y: 'n', fill: t.axis, fillOpacity: 0.6 }),
        Plot.line(rows, { x: 'x', y: 'avg7', stroke: s2, strokeWidth: 2 }),
        Plot.ruleX([rows[0]], { x: 'x', stroke: t.ink, strokeWidth: 1.5, className: 'cursor' }),
        Plot.tip(
          rows,
          Plot.pointerX({ x: 'x', y: 'n', ...tipStyle(t), title: (d) => [fmt(d.date), `${d.n} ships (${d.tankers} tankers)`, `7-day average ${d.avg7}`, eventOn[d.date]].filter(Boolean).join('\n') }),
        ),
      ],
    });
    const xs = plot.scale('x')!;
    const line = plot.querySelector<SVGLineElement>('.cursor line');
    cursor = (i: number) => {
      if (!line) return;
      const px = String(xs.apply(rows[i].x));
      line.setAttribute('x1', px);
      line.setAttribute('x2', px);
    };
    plot.addEventListener('click', (ev) => {
      const r = plot.getBoundingClientRect();
      const d = xs.invert!((ev as MouseEvent).clientX - r.left) as Date;
      const i = Math.max(0, Math.min(days.length - 1, rows.findIndex((row) => +row.x >= +d - 432e5)));
      pause();
      prime(i === -1 ? days.length - 1 : i);
    });
    cursor(Math.floor(pos));
    return plot;
  });

  resize();
  new ResizeObserver(() => resize()).observe(canvas);
  prime(START);
  requestAnimationFrame(frame);

  // Start when the map scrolls into view, unless the reader asked for less motion.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((es) => {
      if (es[0].isIntersecting) {
        play();
        io.disconnect();
      }
    }, { threshold: 0.5 });
    io.observe(canvas);
  }
</script>
