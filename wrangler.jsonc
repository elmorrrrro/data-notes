{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "data-notes",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Custom domains: Cloudflare creates the DNS records and certificates on deploy.
	"routes": [
		{ "pattern": "datanotes.org", "custom_domain": true },
		{ "pattern": "www.datanotes.org", "custom_domain": true }
	],
	"observability": {
		"enabled": true
	}
}